# Copy to release.env (git-ignored) and point at your own signing files.
# Sourced by scripts/release.sh; keep secrets in files, not in this one.

# Developer ID Application certificate + private key, exported as .p12
ATUS_DEVID_P12="$HOME/path/to/developer-id.p12"
ATUS_DEVID_P12_PASSWORD="$(cat "$HOME/path/to/p12.pass")"

# App Store Connect API key used for notarization (Users and Access → Integrations → Team Keys)
ATUS_NOTARY_KEY="$HOME/path/to/AuthKey_XXXXXXXXXX.p8"
ATUS_NOTARY_KEY_ID="XXXXXXXXXX"
ATUS_NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"
